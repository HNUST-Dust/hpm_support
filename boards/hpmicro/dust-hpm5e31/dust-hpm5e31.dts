/dts-v1/;
#include <hpmicro/hpm5e31.dtsi>
#include <zephyr/dt-bindings/pwm/pwm.h>
#include "dust-hpm5e31-pinctrl.dtsi"

/ {
	model = "Dust HPM5E31 EtherCAT Controller";
	compatible = "dust,hpm5e31";

	aliases {
		canbus = &mcan0;
		ethercat0 = &esc0;
		onboard-imu-cs = &imu_cs;
		onboard-imu-int1 = &imu_int1;
		onboard-imu-drdy = &imu_int1;
		onboard-imu-int2 = &imu_int2;
		ethercat-phy-int = &ethercat_phy_int;
		onboard-imu-heater = &onboard_imu_heater;
		onboard-imu-power = &imu_heater_gate;
		pwm-buzzer = &pwm_buzzer;
		coredump-partition = &coredump_partition;
	};

	chosen {
		zephyr,console = &uart0;
		zephyr,sram = &sram;
		zephyr,flash = &flash0;
		zephyr,itcm = &ilm;
		zephyr,dtcm = &dlm;
		zephyr,code-partition = &slot0_partition;
		zephyr,flash-controller = &xpi0;
		zephyr,canbus = &can0;
		wbr-control,oscilloscope-uart = &uart0;
		wbr-control,remote-input-uart = &uart5;
		wbr-control,hi91-uart = &uart6;
		wbr-control,onboard-imu-spi = &spi3;
	};

	board_gpios {
		compatible = "gpio-leds";
		imu_heater_gate: imu_heater_gate { gpios = <&gpiod 4 GPIO_ACTIVE_HIGH>; };
		imu_cs: imu_cs { gpios = <&gpioc 21 GPIO_ACTIVE_LOW>; };
		imu_int1: imu_int1 { gpios = <&gpioc 18 GPIO_ACTIVE_HIGH>; };
		imu_int2: imu_int2 { gpios = <&gpioc 19 GPIO_ACTIVE_HIGH>; };
		ethercat_phy_int: ethercat_phy_int { gpios = <&gpiof 26 GPIO_ACTIVE_LOW>; };
	};

	pwm_outputs {
		compatible = "pwm-leds";
		onboard_imu_heater: onboard_imu_heater {
			status = "disabled";
			/* Heater uses PWM0 counter 2; independent of the buzzer (counter 0). */
			pwms = <&pwm0 4 PWM_HZ(2000) PWM_POLARITY_NORMAL>;
			label = "Onboard IMU heater MOSFET";
		};
		pwm_buzzer: pwm_buzzer {
			pwms = <&pwm0 1 PWM_HZ(4000) PWM_POLARITY_NORMAL>;
			label = "Onboard buzzer";
		};
	};
};

&uart0 {
	status = "okay";
	current-speed = <921600>;
	pinctrl-0 = <&pinmux_uart0>;
	pinctrl-names = "default";
	dmas = <&hdma 0 8>, <&hdma 1 9>;
	dma-names = "rx", "tx";
};

&uart1 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&pinmux_uart1>;
	pinctrl-names = "default";
	dmas = <&hdma 2 10>, <&hdma 3 11>;
	dma-names = "rx", "tx";
};

&uart2 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&pinmux_uart2>;
	pinctrl-names = "default";
	dmas = <&hdma 4 12>, <&hdma 5 13>;
	dma-names = "rx", "tx";
};

&uart3 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&pinmux_uart3>;
	pinctrl-names = "default";
	dmas = <&hdma 6 14>, <&hdma 7 15>;
	dma-names = "rx", "tx";
};

&uart4 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&pinmux_uart4>;
	pinctrl-names = "default";
	dmas = <&xdma 0 16>, <&xdma 1 17>;
	dma-names = "rx", "tx";
};

&uart5 {
	status = "okay";
	current-speed = <100000>;
	pinctrl-0 = <&pinmux_uart5>;
	pinctrl-names = "default";
	dmas = <&xdma 2 18>, <&xdma 3 19>;
	dma-names = "rx", "tx";
};

&uart6 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&pinmux_uart6>;
	pinctrl-names = "default";
	dmas = <&xdma 4 20>, <&xdma 5 21>;
	dma-names = "rx", "tx";
};

/* ICM-42688P: retain the wiring, but do not initialize SPI or start sampling. */
&spi3 {
	status = "disabled";
	pinctrl-0 = <&pinmux_spi3>;
	pinctrl-names = "default";
	cs-gpios = <&gpioc 21 GPIO_ACTIVE_LOW>;
};

&mcan0 { status = "okay"; interrupts = <46 2>; pinctrl-0 = <&pinmux_mcan0>; pinctrl-names = "default"; bitrate = <1000000>; can-transceiver { max-bitrate = <5000000>; }; };
&mcan1 { status = "okay"; interrupts = <47 2>; pinctrl-0 = <&pinmux_mcan1>; pinctrl-names = "default"; bitrate = <1000000>; can-transceiver { max-bitrate = <5000000>; }; };
&mcan2 { status = "okay"; interrupts = <48 2>; pinctrl-0 = <&pinmux_mcan2>; pinctrl-names = "default"; bitrate = <1000000>; can-transceiver { max-bitrate = <5000000>; }; };
&mcan3 { status = "okay"; interrupts = <49 2>; pinctrl-0 = <&pinmux_mcan3>; pinctrl-names = "default"; bitrate = <1000000>; can-transceiver { max-bitrate = <5000000>; }; };

&gpioa { status = "okay"; };
&gpiob { status = "okay"; };
&gpioc {
	status = "okay";
	pinctrl-0 = <&pinmux_imu_gpio>;
	pinctrl-names = "default";
};
&gpiod {
	status = "okay";
	pinctrl-0 = <&pinmux_imu_heater_off>;
	pinctrl-names = "default";
};
&gpioe { status = "okay"; };
&gpiof {
	status = "okay";
	pinctrl-0 = <&pinmux_esc_gpio>;
	pinctrl-names = "default";
};
&hdma { status = "okay"; };
&xdma { status = "okay"; };

&pwm0 {
	status = "okay";
	pinctrl-0 = <&pinmux_pwm0>;
	pinctrl-names = "default";
	period-init = <100>;
	dead-zone-in-half-cycle = <0>;
};

&esc0 {
	status = "okay";
	pinctrl-0 = <&pinmux_esc0>;
	pinctrl-names = "default";
	phy-reset-gpios = <&gpiof 28 GPIO_ACTIVE_LOW>;
	phy-addr-offset = <0>;
	/* Port0: RTL8201F at MDIO 1; port1: TJA1101B at MDIO 0 (schematic straps). */
	software-link0;
	software-link1;
	port1-enabled;
};

cherryusb_usb0: &usb0 {
	compatible = "hpmicro,hpm-cherryusb";
	status = "disabled";
};

&xpi0 {
	status = "okay";
	flash0: flash@0 {
		compatible = "hpmicro,hpmicro-flash", "soc-nv-flash";
		reg = <0x80000000 DT_SIZE_M(1)>;
		erase-block-size = <4096>;
		write-block-size = <1>;
		nor-cfg-opt-hdr = <0xfcf90002>;
		nor-cfg-opt-opt0 = <0x05>;
		nor-cfg-opt-opt1 = <0x1000>;
		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;
			boot_partition: partition@0 { label = "boot"; reg = <0 0x3000>; };
			slot0_partition: partition@3000 { label = "image-0"; reg = <0x3000 0xbc000>; };
			slot1_partition: partition@bf000 { label = "image-1-reserved"; reg = <0xbf000 0x1000>; };
			scratch_partition: partition@c0000 { label = "scratch-reserved"; reg = <0xc0000 0x1000>; };
			ethercat_eeprom_partition: partition@d0000 { label = "ethercat-eeprom"; reg = <0xd0000 0x10000>; };
			coredump_partition: storage_partition: partition@e0000 {
				label = "coredump-partition";
				reg = <0xe0000 0x20000>;
			};
		};
	};
};
