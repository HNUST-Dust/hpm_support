/dts-v1/;

#include <hpmicro/hpm6750.dtsi>
#include "dust-hpm6750-pinctrl.dtsi"
#include <zephyr/dt-bindings/display/panel.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <zephyr/dt-bindings/pwm/pwm.h>

/ {
	model = "Dust HPM6750";
	compatible = "dust,hpm6750";

	aliases {
		led0 = &led_r;
		led1 = &led_g;
		led2 = &led_b;
		sw0 = &pbutn;
		canbus = &can2;
		sdhc0 = &sd0;
		coredump-partition = &coredump_partition;
		onboard-imu-cs = &onboard_imu_cs;
		onboard-imu-drdy = &onboard_imu_drdy;
		onboard-imu-heater = &onboard_imu_heater;
	};

	chosen {
		zephyr,console = &uart0;
		zephyr,shell-uart = &uart0;
		zephyr,sram = &sram;
		zephyr,flash = &flash0;
		zephyr,itcm = &ilm;
		zephyr,dtcm = &dlm;
		zephyr,code-partition = &slot0_partition;
		zephyr,flash-controller = &xpi0;
		zephyr,canbus = &can2;
		wbr-control,remote-input-uart = &uart10;
		wbr-control,oscilloscope-uart = &uart0;
		wbr-control,hi91-uart = &uart2;
		wbr-control,onboard-imu-spi = &spi2;
	};

	dram: memory@40000000 {
		device_type = "memory";
		reg = <0x40000000 DT_SIZE_M(32)>;
	};

	leds {
		compatible = "gpio-leds";
		led_r: led_r {
			gpios = <&gpioc 13 (GPIO_PULL_DOWN | GPIO_ACTIVE_HIGH)>;
			label = "LEDR";
		};
		led_g: led_g {
			gpios = <&gpioc 12 (GPIO_PULL_DOWN | GPIO_ACTIVE_HIGH)>;
			label = "LEDG";
		};
		led_b: led_b {
			gpios = <&gpioc 16 (GPIO_PULL_DOWN | GPIO_ACTIVE_HIGH)>;
			label = "LEDB";
		};
	};

	gpio_keys {
		compatible = "gpio-keys";
		pbutn: pbutn {
			gpios = <&gpioe 31 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			zephyr,code = <INPUT_KEY_0>;
		};
	};

	onboard_imu_gpios {
		compatible = "gpio-leds";

		onboard_imu_cs: onboard_imu_cs {
			gpios = <&gpioa 26 GPIO_ACTIVE_LOW>;
		};

		/* ICM42688P-HXY INT1: active-high data-ready input. */
		onboard_imu_drdy: onboard_imu_drdy {
			gpios = <&gpiob 9 GPIO_ACTIVE_HIGH>;
		};
	};

	pwm_outputs {
		compatible = "pwm-leds";
		onboard_imu_heater: onboard_imu_heater {
			pwms = <&pwm1 0 PWM_KHZ(20) PWM_POLARITY_NORMAL>;
			label = "Onboard IMU heater MOSFET";
		};
	};

};

&rgb0 {
	endpoint_in = <&lcdc0>;
};



&uart0 {
	status = "okay";
	current-speed = <921600>;
	pinctrl-0 = <&pinmux_uart0>;
	pinctrl-names = "default";
	interrupts = <31 1>;
	interrupt-names = "uart";
	/*
	 * UART0 carries VOFA telemetry. HDMA channels are fully occupied by
	 * SPI2, UART2, UART3 and UART10, so use free XDMA channels 0/1.
	 * HPM6750 DMAMUX sources 8 and 9 are UART0 RX and TX respectively.
	 */
	dmas = <&xdma 0 8>, <&xdma 1 9>;
	dma-names = "rx", "tx";
};

&uart2 {
	status = "okay";
	current-speed = <921600>;
	pinctrl-0 = <&pinmux_uart2>;
	pinctrl-names = "default";
	interrupts = <33 1>;
	interrupt-names = "uart";
	dmas = <&hdma 2 12>, <&hdma 3 13>;
	dma-names = "rx", "tx";
};

&uart3 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&pinmux_uart3>;
	pinctrl-names = "default";
	interrupts = <34 1>;
	interrupt-names = "uart";
	dmas = <&hdma 4 14>, <&hdma 5 15>;
	dma-names = "rx", "tx";
};

&uart10 {
	status = "okay";
	current-speed = <100000>;
	parity = "even";
	stop-bits = "2";
	pinctrl-0 = <&pinmux_uart10>;
	pinctrl-names = "default";
	interrupts = <41 1>;
	interrupt-names = "uart";
	dmas = <&hdma 6 28>, <&hdma 7 29>;
	dma-names = "rx", "tx";
};

&uart11 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&pinmux_uart11>;
	pinctrl-names = "default";
	interrupts = <42 1>;
	interrupt-names = "uart";
};

&uart12 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&pinmux_uart12>;
	pinctrl-names = "default";
	interrupts = <43 1>;
	interrupt-names = "uart";
	dmas = <&xdma 2 32>, <&xdma 3 33>;
	dma-names = "rx", "tx";
};

&uart15 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&pinmux_uart15>;
	pinctrl-names = "default";
	interrupts = <46 1>;
	interrupt-names = "uart";
};

&can0 {
	status = "okay";
	pinctrl-0 = <&pinmux_can0>;
	pinctrl-names = "default";
	bitrate = <1000000>;
	can-transceiver {
		max-bitrate = <8000000>;
	};
};

&can1 {
	status = "okay";
	pinctrl-0 = <&pinmux_can1>;
	pinctrl-names = "default";
	bitrate = <1000000>;
	can-transceiver {
		max-bitrate = <8000000>;
	};
};

&can2 {
	status = "okay";
	pinctrl-0 = <&pinmux_can2>;
	pinctrl-names = "default";
	bitrate = <1000000>;
	can-transceiver {
		max-bitrate = <8000000>;
	};
};

&can3 {
	status = "okay";
	pinctrl-0 = <&pinmux_can3>;
	pinctrl-names = "default";
	bitrate = <1000000>;
	can-transceiver {
		max-bitrate = <8000000>;
	};
};


&pwm0 {
	status = "okay";
	pinctrl-0 = <&pinmux_pwm0>;
	pinctrl-names = "default";
	period-init = <100>;
	dead-zone-in-half-cycle = <0>;
};

&pwm1 {
	status = "okay";
	pinctrl-0 = <&pinmux_pwm1_imu_heater>;
	pinctrl-names = "default";
	period-init = <100>;
	dead-zone-in-half-cycle = <0>;
};

&gpiob {
	pinctrl-0 = <&pinmux_gpiob>;
	pinctrl-names = "default";
	status = "okay";
};

&gpioa {
	pinctrl-0 = <&pinmux_gpioa_onboard_imu_cs>;
	pinctrl-names = "default";
	status = "okay";
};

&gpioe {
	pinctrl-0 = <&pinmux_gpioe>;
	pinctrl-names = "default";
	status = "okay";
};

&gpiof {
	pinctrl-0 = <&pinmux_gpiof>;
	pinctrl-names = "default";
	status = "okay";
};

&gpioz {
	pinctrl-0 = <&pinmux_gpioz>;
	pinctrl-names = "default";
	status = "okay";
};

&gpioy {
	pinctrl-0 = <&pinmux_gpioy>;
	pinctrl-names = "default";
	status = "okay";
};

&spi2 {
	status = "okay";
	pinctrl-0 = <&pinmux_spi2>;
	pinctrl-names = "default";
	/* HDMA channels 0 and 1, muxed to SPI2 RX and TX */
	dmas = <&hdma 0 4>, <&hdma 1 5>;
	dma-names = "rx", "tx";
};

&sd0 {
	status = "okay";
	pinctrl-0 = <&pinmux_sd>;
	pinctrl-1 = <&pinmux_sd>;
	pinctrl-2 = <&pinmux_sd>;
	pinctrl-3 = <&pinmux_sd>;
	pinctrl-4 = <&pinmux_sd>;
	pinctrl-names = "default", "slow", "med", "fast", "nopull";
	power-delay-ms = <100>;
	pwr-3v3-support;
	embedded-4-bit-support;

	sdmmc {
		compatible = "zephyr,sdmmc-disk";
		status = "okay";
	};
};

&hdma {
	status = "okay";
};

&xdma {
	status = "okay";
};

&xpi0 {
	status = "okay";
	flash0: flash@0 {
		compatible = "hpmicro,hpmicro-flash", "soc-nv-flash";
		reg = <0x80000000 DT_SIZE_M(16)>;
		status = "okay";
		erase-block-size = <4096>;
		write-block-size = <1>;
		nor-cfg-opt-hdr = <0xfcf90002>;
		nor-cfg-opt-opt0 = <0x00000007>;
		nor-cfg-opt-opt1 = <0x00000100>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			boot_partition: partition@0 {
				label = "mcuboot";
				reg = <0x3000 0x40000>;
			};

			slot0_partition: partition@43000 {
				label = "image-0";
				reg = <0x43000 DT_SIZE_K(1536)>;
			};

			slot1_partition: partition@1c3000 {
				label = "image-1";
				reg = <0x1c3000 DT_SIZE_K(1536)>;
			};

			scratch_partition: partition@343000 {
				label = "image-scratch";
				reg = <0x343000 DT_SIZE_K(128)>;
			};

			storage_partition: partition@363000 {
				label = "storage";
				reg = <0x363000 DT_SIZE_K(128)>;
			};

			coredump_partition: partition@383000 {
				label = "coredump-partition";
				reg = <0x383000 DT_SIZE_K(128)>;
			};
		};
	};
};

&usb0 {
	pinctrl-0 = <&pinmux_usb0>;
	pinctrl-names = "default";
};

&usb1 {
	pinctrl-0 = <&pinmux_usb1>;
	pinctrl-names = "default";
};

zephyr_udc0: &usb0 {
	compatible = "hpmicro,hpm-udc";
	status = "disabled";
};

cherryusb_usb0: &usb0 {
	compatible = "hpmicro,hpm-cherryusb";
	status = "okay";
};
